  "lifecycles": {
    "service_order": {
      "initial": "Draft",
      "states": [
        "Draft",
        "Open",
        "In progress",
        "On hold",
        "Ready for review",
        "Closed",
        "Cancelled"
      ],
      "terminal": [
        "Closed",
        "Cancelled"
      ],
      "transitions": [
        [
          "Draft",
          "Open",
          "submit",
          "customer and vehicle valid"
        ],
        [
          "Draft",
          "Cancelled",
          "cancel",
          "no fulfilled work"
        ],
        [
          "Open",
          "Cancelled",
          "cancel",
          "no net issues or started work"
        ],
        [
          "Open",
          "In progress",
          "start intervention",
          "technician assigned and no overlapping running work"
        ],
        [
          "In progress",
          "On hold",
          "hold",
          "no running intervention or active exclusive equipment session"
        ],
        [
          "On hold",
          "In progress",
          "resume",
          "assigned technician available"
        ],
        [
          "In progress",
          "Ready for review",
          "request review",
          "all interventions completed and requests settled and no active exclusive session"
        ],
        [
          "Ready for review",
          "In progress",
          "return for work",
          "reason recorded"
        ],
        [
          "Ready for review",
          "Closed",
          "close",
          "costs reconciled and manager authorized"
        ]
      ],
      "material_issue_states": [
        "Open",
        "In progress"
      ]
    },
    "intervention": {
      "initial": "Planned",
      "states": [
        "Planned",
        "Running",
        "Paused",
        "Completed"
      ],
      "terminal": [
        "Completed"
      ],
      "transitions": [
        [
          "Planned",
          "Running",
          "start",
          "order permits work and technician assigned and free"
        ],
        [
          "Running",
          "Paused",
          "pause",
          "caller owns running intervention"
        ],
        [
          "Paused",
          "Running",
          "resume",
          "order permits work and technician free"
        ],
        [
          "Running",
          "Completed",
          "finish",
          "outcome supplied and caller authorized"
        ],
        [
          "Paused",
          "Completed",
          "finish",
          "outcome supplied and caller authorized"
        ]
      ],
      "effects": {
        "Planned:start": "open running time segment",
        "Running:pause": "close running time segment",
        "Paused:resume": "open new running time segment",
        "Running:finish": "close segment and record outcome",
        "Paused:finish": "record outcome; do not add paused time"
      }
    },
    "equipment": {
      "initial": "Unknown power",
      "states": [
        "Unknown power",
        "Off",
        "Powered unknown activity",
        "Working",
        "Idle"
      ],
      "terminal": [],
      "transitions": [
        [
          "Unknown power",
          "Off",
          "power sample",
          "off observed"
        ],
        [
          "Unknown power",
          "Powered unknown activity",
          "power sample",
          "on observed and activity unknown"
        ],
        [
          "Unknown power",
          "Working",
          "complete sample",
          "on and working observed"
        ],
        [
          "Unknown power",
          "Idle",
          "complete sample",
          "on and idle observed"
        ],
        [
          "Off",
          "Powered unknown activity",
          "power on",
          "new event accepted"
        ],
        [
          "Powered unknown activity",
          "Working",
          "activity sample",
          "working observed"
        ],
        [
          "Powered unknown activity",
          "Idle",
          "activity sample",
          "idle observed"
        ],
        [
          "Working",
          "Idle",
          "activity idle",
          "timestamp accepted"
        ],
        [
          "Idle",
          "Working",
          "activity working",
          "timestamp accepted"
        ],
        [
          "Working",
          "Powered unknown activity",
          "activity stale",
          "power remains known on"
        ],
        [
          "Idle",
          "Powered unknown activity",
          "activity stale",
          "power remains known on"
        ],
        [
          "Powered unknown activity",
          "Off",
          "power off",
          "timestamp accepted"
        ],
        [
          "Working",
          "Off",
          "power off",
          "timestamp accepted"
        ],
        [
          "Idle",
          "Off",
          "power off",
          "timestamp accepted"
        ],
        [
          "Off",
          "Unknown power",
          "heartbeat timeout",
          "freshness limit exceeded"
        ],
        [
          "Powered unknown activity",
          "Unknown power",
          "heartbeat timeout",
          "freshness limit exceeded"
        ],
        [
          "Working",
          "Unknown power",
          "heartbeat timeout",
          "freshness limit exceeded"
        ],
        [
          "Idle",
          "Unknown power",
          "heartbeat timeout",
          "freshness limit exceeded"
        ]
      ]
    }
  },
