p3 [shape=ellipse, fillcolor="#c9e8e1", label="3.0\nManage stock and purchasing"];
p6 [shape=ellipse, fillcolor="#f3f6fa", label="6.0\nReport and run scenarios"];
technician [shape=box, style=filled, fillcolor="#ffffff", label="Technician"];
