"p1" -> "p3" [label="Authorized identity and scenario\ncontext"];
"d2" -> "p3" [label="Order state and assigned technician"];
"p3" -> "d3" [label="Requests movements and purchase\nchanges"];
"d3" -> "p3" [label="Stock costs demand and outstanding\npurchases"];
