digraph dfd_level_1 {
graph [rankdir=TB, bgcolor="#171e24", pad="0.35", nodesep="0.55", ranksep="0.8", fontname="Arial", fontsize=20, fontcolor="#e5edf3", labelloc=t, label="DFD Level 1 - logical processes and data stores", compound=true];
node [shape=box, style="rounded,filled", fillcolor="#232e37", color="#697b8b", fontcolor="#e5edf3", fontname="Arial", fontsize=13, margin="0.18,0.13"];
edge [fontname="Arial", fontsize=11, fontcolor="#c0ccd6", color="#9eacb7", arrowsize=0.75];
staff [shape=box, style=filled, fillcolor="#171e24", label="Staff member\n(all four operational roles)"];
manager [shape=box, style=filled, fillcolor="#171e24", label="Workshop manager"];
technician [shape=box, style=filled, fillcolor="#171e24", label="Technician"];
clerk [shape=box, style=filled, fillcolor="#171e24", label="Warehouse clerk"];
admin [shape=box, style=filled, fillcolor="#171e24", label="Administrator"];
telemetry [shape=box, style=filled, fillcolor="#171e24", label="Simulated telemetry source"];
recipient [shape=box, style=filled, fillcolor="#171e24", label="Invoice recipient\n(no customer portal)"];
operator [shape=box, style=filled, fillcolor="#171e24", label="Demonstration operator\n(own scenario only)"];
subgraph cluster_app { label="Mechanical Workshop - first decomposition"; color="#596977";
p1 [shape=ellipse, fillcolor="#442b1c", label="1.0\nManage identity and access"];
p2 [shape=ellipse, fillcolor="#442b1c", label="2.0\nManage workshop operations"];
p3 [shape=ellipse, fillcolor="#442b1c", label="3.0\nManage stock and purchasing"];
p4 [shape=ellipse, fillcolor="#442b1c", label="4.0\nMonitor equipment"];
p5 [shape=ellipse, fillcolor="#442b1c", label="5.0\nCalculate costs and invoice"];
p6 [shape=ellipse, fillcolor="#442b1c", label="6.0\nReport and run scenarios"];
d1 [shape=record, style=filled, fillcolor="#302a22", label="D1 | Identity and permissions"];
d2 [shape=record, style=filled, fillcolor="#302a22", label="D2 | Customers vehicles orders and interventions"];
d3 [shape=record, style=filled, fillcolor="#302a22", label="D3 | Items requests movements and purchases"];
d4 [shape=record, style=filled, fillcolor="#302a22", label="D4 | Equipment events sessions and alerts"];
d5 [shape=record, style=filled, fillcolor="#302a22", label="D5 | Cost snapshots and invoices"];
d6 [shape=record, style=filled, fillcolor="#302a22", label="D6 | Scenario clock and ownership"];
d7 [shape=record, style=filled, fillcolor="#302a22", label="D7 | Audit trail"];
}
"staff" -> "p1" [label="F01\nSign-in credentials"];
"p1" -> "staff" [label="F02\nSession or access error"];
"manager" -> "p2" [label="F03\nOrders and assignment commands"];
"p2" -> "manager" [label="F04\nOrder and workload status"];
"technician" -> "p2" [label="F05\nIntervention commands"];
"p2" -> "technician" [label="F06\nAssigned work and intervention\nstatus"];
"technician" -> "p3" [label="F07\nMaterial requests and return\ndeclarations"];
"p3" -> "technician" [label="F08\nRequest and return status"];
"clerk" -> "p3" [label="F09\nIssues receipts returns and\nadjustments"];
"p3" -> "clerk" [label="F10\nStock and fulfillment results"];
"admin" -> "p3" [label="F11\nPurchase decisions and reorder\nsettings"];
"p3" -> "admin" [label="F12\nPurchase suggestions and order\nstatus"];
"telemetry" -> "p4" [label="F13\nPower activity and heartbeat events"];
"p4" -> "telemetry" [label="F14\nEvent acceptance or rejection"];
"manager" -> "p4" [label="F15\nEquipment actions and alert\nacknowledgement"];
"p4" -> "manager" [label="F16\nUtilization alerts and action\nresults"];
"admin" -> "p5" [label="F17\nCost review and invoice command"];
"p5" -> "admin" [label="F18\nCost breakdown and invoice result"];
"p5" -> "recipient" [label="F19\nEducational invoice document"];
"admin" -> "p6" [label="F20\nReport and history query"];
"p6" -> "admin" [label="F21\nIndicators and period reports"];
"operator" -> "p6" [label="F22\nScenario create pause advance and\nreset commands"];
"p6" -> "operator" [label="F23\nScenario status and comparison\nresults"];
"p1" -> "d1" [label="Session and login attempt record", color="#8297a8", fontcolor="#b3c2cc"];
"d1" -> "p1" [label="Account role and credential verifier", color="#8297a8", fontcolor="#b3c2cc"];
