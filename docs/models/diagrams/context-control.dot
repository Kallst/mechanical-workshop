digraph context_control {
graph [rankdir=LR, bgcolor="#171e24", pad="0.35", nodesep="0.55", ranksep="0.8", fontname="Arial", fontsize=20, fontcolor="#e5edf3", labelloc=t, label="Application context - monitoring and delivery view", compound=true];
node [shape=box, style="rounded,filled", fillcolor="#232e37", color="#697b8b", fontcolor="#e5edf3", fontname="Arial", fontsize=13, margin="0.18,0.13"];
edge [fontname="Arial", fontsize=11, fontcolor="#c0ccd6", color="#9eacb7", arrowsize=0.75];
app [shape=ellipse, fillcolor="#442b1c", color="#f28a3a", penwidth=1.6, label="0\nMechanical Workshop\ninformation system"];
"telemetry" -> "app" [label="F13\nPower activity and heartbeat events", constraint=false];
"app" -> "telemetry" [label="F14\nEvent acceptance or rejection", constraint=false];
"manager" -> "app" [label="F15\nEquipment actions and alert\nacknowledgement", constraint=false];
"app" -> "manager" [label="F16\nUtilization alerts and action\nresults", constraint=false];
"admin" -> "app" [label="F17\nCost review and invoice command", constraint=false];
"app" -> "admin" [label="F18\nCost breakdown and invoice result", constraint=false];
"app" -> "recipient" [label="F19\nEducational invoice document", constraint=false];
"admin" -> "app" [label="F20\nReport and history query", constraint=false];
"app" -> "admin" [label="F21\nIndicators and period reports", constraint=false];
"operator" -> "app" [label="F22\nScenario create pause advance and\nreset commands", constraint=false];
"app" -> "operator" [label="F23\nScenario status and comparison\nresults", constraint=false];
admin [shape=box, style="filled", fillcolor="#171e24", label="Administrator"];
manager [shape=box, style="filled", fillcolor="#171e24", label="Workshop manager"];
operator [shape=box, style="filled", fillcolor="#171e24", label="Demonstration operator\n(own scenario only)"];
recipient [shape=box, style="filled", fillcolor="#171e24", label="Invoice recipient\n(no customer portal)"];
telemetry [shape=box, style="filled", fillcolor="#171e24", label="Simulated telemetry source"];
{rank=same; manager; admin; telemetry;}
{rank=same; recipient; operator;}
manager -> app [style=invis, weight=100];
admin -> app [style=invis, weight=100];
telemetry -> app [style=invis, weight=100];
app -> recipient [style=invis, weight=100];
app -> operator [style=invis, weight=100];

}
