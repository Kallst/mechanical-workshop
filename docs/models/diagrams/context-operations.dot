digraph context_operations {
graph [rankdir=LR, bgcolor="#171e24", pad="0.35", nodesep="0.55", ranksep="0.8", fontname="Arial", fontsize=20, fontcolor="#e5edf3", labelloc=t, label="Application context - operational view", compound=true];
node [shape=box, style="rounded,filled", fillcolor="#232e37", color="#697b8b", fontcolor="#e5edf3", fontname="Arial", fontsize=13, margin="0.18,0.13"];
edge [fontname="Arial", fontsize=11, fontcolor="#c0ccd6", color="#9eacb7", arrowsize=0.75];
app [shape=ellipse, fillcolor="#442b1c", color="#f28a3a", penwidth=1.6, label="0\nMechanical Workshop\ninformation system"];
"staff" -> "app" [label="F01\nSign-in credentials", constraint=false];
"app" -> "staff" [label="F02\nSession or access error", constraint=false];
"manager" -> "app" [label="F03\nOrders and assignment commands", constraint=false];
"app" -> "manager" [label="F04\nOrder and workload status", constraint=false];
"technician" -> "app" [label="F05\nIntervention commands", constraint=false];
"app" -> "technician" [label="F06\nAssigned work and intervention\nstatus", constraint=false];
"technician" -> "app" [label="F07\nMaterial requests and return\ndeclarations", constraint=false];
"app" -> "technician" [label="F08\nRequest and return status", constraint=false];
"clerk" -> "app" [label="F09\nIssues receipts returns and\nadjustments", constraint=false];
"app" -> "clerk" [label="F10\nStock and fulfillment results", constraint=false];
"admin" -> "app" [label="F11\nPurchase decisions and reorder\nsettings", constraint=false];
"app" -> "admin" [label="F12\nPurchase suggestions and order\nstatus", constraint=false];
admin [shape=box, style="filled", fillcolor="#171e24", label="Administrator"];
clerk [shape=box, style="filled", fillcolor="#171e24", label="Warehouse clerk"];
manager [shape=box, style="filled", fillcolor="#171e24", label="Workshop manager"];
staff [shape=box, style="filled", fillcolor="#171e24", label="Staff member\n(all four operational roles)"];
technician [shape=box, style="filled", fillcolor="#171e24", label="Technician"];
{rank=same; staff; manager; technician;}
{rank=same; clerk; admin;}
staff -> app [style=invis, weight=100];
manager -> app [style=invis, weight=100];
technician -> app [style=invis, weight=100];
app -> clerk [style=invis, weight=100];
app -> admin [style=invis, weight=100];

}
