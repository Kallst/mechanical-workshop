digraph causal_inventory {
graph [rankdir=LR, bgcolor="#171e24", pad="0.35", nodesep="0.55", ranksep="0.8", fontname="Arial", fontsize=20, fontcolor="#e5edf3", labelloc=t, label="B1 - inventory replenishment feedback", compound=true];
node [shape=box, style="rounded,filled", fillcolor="#232e37", color="#697b8b", fontcolor="#e5edf3", fontname="Arial", fontsize=13, margin="0.18,0.13"];
edge [fontname="Arial", fontsize=11, fontcolor="#c0ccd6", color="#9eacb7", arrowsize=0.75];

stock [label="Available inventory"];
shortage [label="Inventory shortfall\nagainst replenishment target"];
suggestions [label="Suggested replenishment\nquantity"];
authorization [label="Authorized purchase\nquantity"];
receipts [label="Received material\nquantity"];
control [shape=note, fillcolor="#302a22", label="B1 - balancing loop\nOne negative influence.\nReorder suggestion alone does not restore stock.\nPurchasing and supplier lead time create delays."];
"stock" -> "shortage" [label="-"];
"shortage" -> "suggestions" [label="+"];
"suggestions" -> "authorization" [label="+\n[administrator approval required]"];
"authorization" -> "receipts" [label="+\n[ordering and delivery delay]"];
"receipts" -> "stock" [label="+"];

}
