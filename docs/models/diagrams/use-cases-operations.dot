digraph use_cases_operations {
graph [rankdir=LR, bgcolor="#171e24", pad="0.35", nodesep="0.55", ranksep="0.8", fontname="Arial", fontsize=20, fontcolor="#e5edf3", labelloc=t, label="Use cases - workshop and warehouse", compound=true];
node [shape=box, style="rounded,filled", fillcolor="#232e37", color="#697b8b", fontcolor="#e5edf3", fontname="Arial", fontsize=13, margin="0.18,0.13"];
edge [fontname="Arial", fontsize=11, fontcolor="#c0ccd6", color="#9eacb7", arrowsize=0.75];
admin [shape=box, style=filled, fillcolor="#171e24", label="<<actor>>\nAdministrator"];
clerk [shape=box, style=filled, fillcolor="#171e24", label="<<actor>>\nWarehouse clerk"];
manager [shape=box, style=filled, fillcolor="#171e24", label="<<actor>>\nWorkshop manager"];
technician [shape=box, style=filled, fillcolor="#171e24", label="<<actor>>\nTechnician"];
subgraph cluster_subject { label="Mechanical Workshop"; labeljust=l; color="#596977";
"UC-01" [shape=ellipse, label="UC-01\nMaintain customers and vehicles"];
"UC-02" [shape=ellipse, label="UC-02\nManage service orders"];
"UC-03" [shape=ellipse, label="UC-03\nAssign technicians"];
"UC-04" [shape=ellipse, label="UC-04\nRecord interventions"];
"UC-05" [shape=ellipse, label="UC-05\nRequest materials"];
"UC-06" [shape=ellipse, label="UC-06\nIssue materials"];
"UC-07" [shape=ellipse, label="UC-07\nAccept material returns"];
"UC-08" [shape=ellipse, label="UC-08\nReceive or adjust stock"];
"UC-09" [shape=ellipse, label="UC-09\nManage replenishment"];
S1 [shape=ellipse, fillcolor="#302a22", label="Validate order and assignment"];
S2 [shape=ellipse, fillcolor="#302a22", label="Commit stock movement"];
S3 [shape=ellipse, fillcolor="#302a22", label="Suggest replenishment"];
}
"manager" -> "UC-01" [label="", dir=none];
"manager" -> "UC-02" [label="", dir=none];
"manager" -> "UC-03" [label="", dir=none];
"technician" -> "UC-04" [label="", dir=none];
"technician" -> "UC-05" [label="", dir=none];
"clerk" -> "UC-06" [label="", dir=none];
"clerk" -> "UC-07" [label="", dir=none];
"clerk" -> "UC-08" [label="", dir=none];
"admin" -> "UC-09" [label="", dir=none];
"clerk" -> "UC-09" [label="", dir=none];
"UC-06" -> "S1" [label="<<include>>", style=dashed, arrowhead=vee, color="#e69c60"];
"UC-06" -> "S2" [label="<<include>>", style=dashed, arrowhead=vee, color="#e69c60"];
"UC-07" -> "S2" [label="<<include>>", style=dashed, arrowhead=vee, color="#e69c60"];
"UC-08" -> "S2" [label="<<include>>", style=dashed, arrowhead=vee, color="#e69c60"];
"S3" -> "UC-06" [label="<<extend>>\nafter stock commit [inventory\nposition below reorder point]", style=dashed, arrowhead=vee, color="#e69c60"];

}
