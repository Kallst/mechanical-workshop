digraph causal_energy {
graph [rankdir=LR, bgcolor="#171e24", pad="0.35", nodesep="0.55", ranksep="0.8", fontname="Arial", fontsize=20, fontcolor="#e5edf3", labelloc=t, label="B2 - idle equipment control feedback", compound=true];
node [shape=box, style="rounded,filled", fillcolor="#232e37", color="#697b8b", fontcolor="#e5edf3", fontname="Arial", fontsize=13, margin="0.18,0.13"];
edge [fontname="Arial", fontsize=11, fontcolor="#c0ccd6", color="#9eacb7", arrowsize=0.75];

idle [label="Powered idle time\nper operating window"];
alerts [label="Open idle alerts"];
response [label="Acknowledged alerts\nwith corrective action"];
cost [label="Estimated idle energy cost\nper operating window"];
control [shape=note, fillcolor="#302a22", label="B2 - balancing loop\nAction reduces future powered idle duration.\nDetection threshold and human response add delay.\nAcknowledgement without action has no guaranteed effect."];
"idle" -> "alerts" [label="+\n[15-minute detection delay]"];
"alerts" -> "response" [label="+\n[human response delay]"];
"response" -> "idle" [label="-\n[power off or resume useful work]"];
"idle" -> "cost" [label="+\n[fixed power profile and tariff]"];

}
