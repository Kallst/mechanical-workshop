{
  "name": "mechanical-workshop",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3070",
    "build": "next build --webpack",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "db:local": "node scripts/local-postgres.mjs start",
    "db:stop": "node scripts/local-postgres.mjs stop",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env.local --import tsx scripts/seed.ts",
    "test": "node --env-file-if-exists=.env.local --import tsx --test tests/*.test.ts",
    "test:integration": "node --env-file-if-exists=.env.local --import tsx --test tests/integration/*.test.ts",
    "check:design": "python tools/design/verify-design.py",
    "backup": "node --env-file-if-exists=.env.local scripts/backup.mjs",
    "start:server": "next start --hostname 127.0.0.1 --port 3070",
    "test:startup": "node --test tests/startup.test.mjs"
  },
  "dependencies": {
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
